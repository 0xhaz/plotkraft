# Copy to apps/api/.env (server) and apps/web/.env.local (client)

# --- Server (NestJS) ---
GCP_PROJECT_ID=plotkraft-agentic
GCP_LOCATION=us-central1
GOOGLE_GENAI_API_KEY=
PARALLEL_API_KEY=
GCS_BUCKET=plotkraft-agentic-assets

# --- Client (Next.js) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=plotkraft-agentic.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=plotkraft-agentic
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=plotkraft-agentic-assets
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- Local emulator development ---
# Set these when running against the Firebase emulators (pnpm emulators):
#   FIRESTORE_EMULATOR_HOST=127.0.0.1:8181
#   NEXT_PUBLIC_USE_EMULATORS=true
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:8088
